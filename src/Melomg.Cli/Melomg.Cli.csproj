<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <WindowsSdkPackageVersion>10.0.19041.57</WindowsSdkPackageVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <AssemblyName>melomg</AssemblyName>
    <RootNamespace>Melomg.Cli</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Suppress IL2104 from external Microsoft WinRT projections (Microsoft.Windows.SDK.NET / WinRT.Runtime) while keeping strict trim warnings-as-errors for all Melomg code -->
    <NoWarn>$(NoWarn);IL2104</NoWarn>
    <PublishDir>..\..\app\</PublishDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <TrimmerRootAssembly Include="Microsoft.ML.OnnxRuntime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Melomg.Application\Melomg.Application.csproj" />
    <ProjectReference Include="..\Melomg.Infrastructure\Melomg.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
  </ItemGroup>

  <Target Name="RenamePublishedExecutable" AfterTargets="Publish">
    <PropertyGroup>
      <_PublishedSourceExe>$([System.IO.Path]::Combine('$(PublishDir)', '$(AssemblyName).exe'))</_PublishedSourceExe>
      <_PublishedTargetExe>$([System.IO.Path]::Combine('$(PublishDir)', 'meloberry-melomg-$(Version).exe'))</_PublishedTargetExe>
    </PropertyGroup>
    <Delete Files="$(_PublishedTargetExe)" Condition="Exists('$(_PublishedTargetExe)')" />
    <Move SourceFiles="$(_PublishedSourceExe)" DestinationFiles="$(_PublishedTargetExe)" Condition="Exists('$(_PublishedSourceExe)')" />
    <Message Importance="High" Text="Published executable: $(_PublishedTargetExe)" Condition="Exists('$(_PublishedTargetExe)')" />
  </Target>

</Project>
