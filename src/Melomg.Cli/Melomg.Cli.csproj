<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <WindowsSdkPackageVersion>10.0.19041.57</WindowsSdkPackageVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <AssemblyName>melomg</AssemblyName>
    <RootNamespace>Melomg.Cli</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Suppress IL2104 from external Microsoft WinRT projections (Microsoft.Windows.SDK.NET / WinRT.Runtime) while keeping strict trim warnings-as-errors for all Melomg code -->
    <NoWarn>$(NoWarn);IL2104</NoWarn>
    <PublishDir>..\..\app\</PublishDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <TrimmerRootAssembly Include="Microsoft.ML.OnnxRuntime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Melomg.Application\Melomg.Application.csproj" />
    <ProjectReference Include="..\Melomg.Infrastructure\Melomg.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\README.md" LogicalName="Melomg.Cli.Docs.README.md" />
    <EmbeddedResource Include="..\..\docs\COMMANDS.md" LogicalName="Melomg.Cli.Docs.COMMANDS.md" />
    <EmbeddedResource Include="..\..\docs\ONNX_AND_DETECTION.md" LogicalName="Melomg.Cli.Docs.ONNX_AND_DETECTION.md" />
    <EmbeddedResource Include="..\..\docs\AI_AGENT_PLAYBOOK.md" LogicalName="Melomg.Cli.Docs.AI_AGENT_PLAYBOOK.md" />
    <EmbeddedResource Include="..\..\docs\ARCHITECTURE.md" LogicalName="Melomg.Cli.Docs.ARCHITECTURE.md" />
  </ItemGroup>

</Project>
